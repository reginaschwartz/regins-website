# Copy to .env and fill in from the Meta app dashboard.
# Leave WHATSAPP_ACCESS_TOKEN empty to keep the bot in dry-run mode.

# Any string you invent; paste the same value into the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=choose-a-random-string

# WhatsApp > API Setup > Temporary access token (swap for a System User token later)
WHATSAPP_ACCESS_TOKEN=

# ls -la
WHATSAPP_PHONE_NUMBER_ID=

# App Settings > Basic > App secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=

GRAPH_API_VERSION=v25.0
DRY_RUN=false

